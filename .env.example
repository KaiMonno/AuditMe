# Copy this file to .env and fill in a real key.
# .env is gitignored — never commit a real key.
GEMINI_API_KEY=your-api-key-here

# Optional — defaults to gemini-3.6-flash if unset.
# GEMINI_MODEL=gemini-3.6-flash

# Optional — API server port, defaults to 3001.
# PORT=3001

# Optional — navigation timeout per audit in ms, defaults to 30000.
# Raise this on a CPU-constrained host: measured directly on a container
# limited to Render's free-tier numbers (0.15 CPU), even example.com took
# 25-32s. 60000 is a reasonable floor there.
# AUDIT_NAV_TIMEOUT_MS=60000

# Optional — how many audits run at once, defaults to 1. Each audit
# launches a full browser process; on a CPU/memory-constrained host,
# running more than one concurrently doesn't speed anything up (verified:
# CPU stays pegged at the same ~15% regardless of how many run at once) —
# it only multiplies memory use. Only raise this on a host with real spare
# CPU/RAM headroom.
# MAX_CONCURRENT_AUDITS=1
